# MCS-51 family SoCs and machines

config STC32G144K246
    bool
    default y
    depends on MCS251
    select STC32G_GPIO
    select STC32G_TIMER
    select STC32G_UART
    select STC32G_DSP
    select STC32G_TFPU

config STC32G_DSP
    bool
    depends on MCS251
    select REGISTER

config STC32G_TFPU
    bool
    depends on MCS251
    select REGISTER
